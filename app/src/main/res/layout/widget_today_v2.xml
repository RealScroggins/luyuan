<?xml version="1.0" encoding="utf-8"?>
<!-- 今日卡 · 视觉稿对齐版（2026-09-10 v2，对应 ui-mobile/widget/index.html W1）
     ⚠️ vivo 渲染红线（上次加桌只显圆圈的教训，务必守住）：
       ✅ 只用 LinearLayout / TextView / ImageView（RemoteViews 支持 setImageViewResource）
       ✅ 嵌套 ≤3 层（根 → 行容器 → 图标/文字）
       ✅ 属性只用基础集；不用 paddingVertical / layout_marginStart/End（用 marginLeft/Right）
       ✅ 背景一律预置 drawable，不在代码里动态 setBackgroundColor
       ❌ 不用裸 View 分隔线（1dp 竖线改用 TextView + 背景色代替，见统计行）
     结构（自上而下，对齐视觉稿 W1）：
       1 标题行：浅绿圆底 + 叶子图标 +「路远」+ 日期
       2 课程块（深绿）：左侧「下一节·14:00 / 数据结构 / 计算机楼A302·张老师」+ 右侧大号「45′ / 后上课」
       3 统计行：琥珀圆底时钟 +「今天待办 / 2件 1件过期」｜竖线｜浅绿圆底钱包 +「本月支出 / ¥1284.5」
       4 双键：铅笔+记一笔（深绿实心）/ 麦克风+说一句（浅绿描边）
     4×2 与 4×3 差异：Provider 按高度控制「最近」段显隐（本版不含最近段，见 widget_today_flat 的 recent） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_today_bg"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 1 标题行：圆底叶子 + 路远 + 日期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_logo_ic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_logo_circle"
            android:padding="3dp"
            android:src="@drawable/ic_wg_leaf"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="路远"
            android:textColor="#224A3A"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:textColor="#8A9690"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 2 课程块（深绿）：左三行 + 右大号倒计时 -->
    <LinearLayout
        android:id="@+id/widget_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_course_bg"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="11dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_course_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下一节 · 14:00"
                android:textColor="#B3FFFFFF"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/widget_course_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_course_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#C7FFFFFF"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="right">

            <TextView
                android:id="@+id/widget_course_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_course_countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后上课"
                android:textColor="#BFFFFFFF"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3 统计行：待办 ｜ 支出 -->
    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="11dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_stat_icon_amber"
            android:padding="7dp"
            android:src="@drawable/ic_wg_clock"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天待办"
                android:textColor="#8A9690"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/widget_todo_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#1A3329"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:background="#ECE6D8" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_stat_icon_green"
            android:padding="7dp"
            android:src="@drawable/ic_wg_ledger"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月支出"
                android:textColor="#8A9690"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/widget_expense_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#1A3329"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3.5 最近 3 条（Provider 按卡片高度控制整段显隐） -->
    <LinearLayout
        android:id="@+id/widget_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="9dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近"
            android:textColor="#8A9690"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/widget_recent_tx_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#4A5A52"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_recent_tx_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#4A5A52"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_recent_tx_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#4A5A52"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 4 双键：记一笔 / 说一句 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="11dp">

        <LinearLayout
            android:id="@+id/widget_note"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_wg_edit"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="记一笔"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_record"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="horizontal"
            android:background="@drawable/widget_btn_secondary"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_wg_mic"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="说一句"
                android:textColor="#224A3A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
