<?xml version="1.0" encoding="utf-8"?>
<!-- 今日卡 · 扁平版（vivo OriginOS 兼容专用，2026-09-10）
     背景：复杂嵌套布局（12 层）在 vivo 上「加桌只剩系统圆圈」；
     而结构最简单的速记条（1 层容器 + 2 个 TextView）显示正常。
     本布局刻意向速记条看齐：单层 LinearLayout、无嵌套、无 View 分隔线、
     只用 LinearLayout + TextView，属性只用最基础和最常见的几个。
     内容 = 下一节课 + 待办/支出 + 双键，够用即可，后续确认能显示再逐步加回。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_today_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 第 1 行：标题 + 日期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_logo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="路远"
            android:textColor="#224A3A"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A9690"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 第 2 行：下一节课（单行，不套背景块） -->
    <TextView
        android:id="@+id/widget_course_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="#224A3A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 第 3 行：教室/老师 + 倒计时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp">
        <TextView
            android:id="@+id/widget_course_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#8A9690"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_course_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#224A3A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第 4 行：待办 + 支出 -->
    <TextView
        android:id="@+id/widget_todo_val"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="#4A5A52"
        android:textSize="11sp"
        android:maxLines="1" />

    <!-- 第 5 行：底部双键 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_note"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:text="记一笔"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/widget_record"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_secondary"
            android:text="说一句"
            android:textColor="#224A3A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
