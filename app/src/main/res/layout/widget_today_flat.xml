<?xml version="1.0" encoding="utf-8"?>
<!-- 今日卡 · 完整扁平版（2026-09-10）
     背景：12 层嵌套布局在 vivo 上「加桌只剩系统圆圈」；已证实扁平结构可正常显示。
     本版在扁平前提下把内容补齐，同时严守 vivo 兼容红线：
       ✅ 只用 LinearLayout + TextView（无 View、无 ImageView、无自定义 View）
       ✅ 属性只用最基础集（layout_*/orientation/padding*/text*/gravity/maxLines/ellipsize/background/clickable/focusable）
       ✅ 嵌套最多 2 层（根 → 行容器 → 文字）
       ❌ 不用 paddingVertical / layout_marginHorizontal 等 API 26+ 属性
       ❌ 不用 layout_marginStart/End（改用 padding，新旧 ROM 都稳）
     布局（自上而下）：
       1 标题行：路远 + 日期
       2 课程块（深绿背景，两种状态：有课 / 今天没课）
       3 统计行：待办数 + 本月支出
       4 最近：标题 + 3 条（每条 = 圆点·文字·时间）
       5 双键：记一笔 / 说一句
     4×2 与 4×3 的差异由 Provider 按高度控制「最近」段显隐。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_today_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 1 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_logo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="路远"
            android:textColor="#224A3A"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A9690"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 2 课程块 -->
    <LinearLayout
        android:id="@+id/widget_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_course_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_course_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="下一节"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/widget_course_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_course_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_course_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 3 统计行：待办 / 支出 -->
    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待办 "
            android:textColor="#8A9690"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_todo_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1A3329"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_expense_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1A3329"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 4 最近 3 条（Provider 按高度控制整段显隐） -->
    <LinearLayout
        android:id="@+id/widget_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近"
            android:textColor="#8A9690"
            android:textSize="9sp" />

        <LinearLayout
            android:id="@+id/widget_recent_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="· "
                android:textColor="#224A3A"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_recent_tx_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#4A5A52"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_recent_tm_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8C0BB"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_recent_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="· "
                android:textColor="#224A3A"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_recent_tx_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#4A5A52"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_recent_tm_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8C0BB"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_recent_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="· "
                android:textColor="#224A3A"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_recent_tx_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#4A5A52"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_recent_tm_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8C0BB"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5 底部双键 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">
        <TextView
            android:id="@+id/widget_note"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:text="记一笔"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/widget_record"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_secondary"
            android:text="说一句"
            android:textColor="#224A3A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginLeft="8dp" />
    </LinearLayout>
</LinearLayout>
