<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小部件「路远·今日卡」：RemoteViews 只认传统 View，不能用 Compose。
     4×2 基础版（最近段由 Provider 按高度显隐）；拉到 4×3 时显示「最近 3 条」。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_today_bg"
    android:padding="12dp">

    <!-- 头部：logo + 日期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/widget_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="路远"
            android:textColor="#224A3A"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A9690"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 课程块（深绿）：点 → 课程页 -->
    <LinearLayout
        android:id="@+id/widget_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_course_bg"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_course_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="下一节"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/widget_course_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_course_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_course_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 统计行：待办 / 支出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">
        <LinearLayout
            android:id="@+id/widget_todo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天待办"
                android:textColor="#8A9690"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_todo_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— 件"
                android:textColor="#1A3329"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E6E2DA"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:id="@+id/widget_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月支出"
                android:textColor="#8A9690"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_expense_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥—"
                android:textColor="#1A3329"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 最近 3 条（4×3 才显示；Provider 控制显隐） -->
    <LinearLayout
        android:id="@+id/widget_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近"
            android:textColor="#8A9690"
            android:textSize="9sp"
            android:paddingBottom="4dp" />
        <LinearLayout
            android:id="@+id/widget_recent_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_bullet"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/widget_recent_tx_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#4A5A52"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_recent_tm_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8C0BB"
                android:textSize="9sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_recent_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_bullet"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/widget_recent_tx_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#4A5A52"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_recent_tm_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8C0BB"
                android:textSize="9sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_recent_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_bullet"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/widget_recent_tx_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#4A5A52"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_recent_tm_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8C0BB"
                android:textSize="9sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部双键：记一笔 / 说一句 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_note"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:text="记一笔"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/widget_record"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_secondary"
            android:text="说一句"
            android:textColor="#224A3A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
